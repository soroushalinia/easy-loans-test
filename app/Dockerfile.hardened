# HARDENED build: pinned base by digest, non-root, read-only, hashed deps.
# Build stage ------------------------------------------------------------
FROM python:3.11-slim@sha256:78b39ef14d8e2b4d71f8dc304f1328c37df95fe0ef99477c2ae6bd3d03784553 AS build-stage
# NOTE: pin a REAL digest with:  docker buildx imagetools inspect python:3.11-slim
#       and put the resulting sha256:... after the tag. Pseudo-digest = example.
WORKDIR /srv

COPY app/requirements.txt requirements.txt
# pip version + hashes locked; never "latest"
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && python -m pip check

# Runtime stage -----------------------------------------------------------
FROM gcr.io/distroless/base-debian12@sha256:6dda3ce74e0685a5de84634001c2fa6f3fd134b77c39c4cb1ad697dc1b5da1c4
COPY --from=build-stage /install     /usr/local
COPY --chmod=0444 app/app.py          /app/app.py
COPY --chmod=0555 app/entrypoint.sh   /app/entrypoint.sh

USER 65534:65534                       # nobody
WORKDIR /app
# no shell, no package manager, no secrets baked in
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]